<aside class="doc-sidebar" aria-label="Documentation" data-toggle-target="item" data-drawer>
  <%= slotted :before %>
  <ul class="sidebar-list" data-controller="sidebar">
    <% @data.each do |page| %>
      <%= render Shared::Sidebar::Item.new(page: page, current: @current) %>
    <% end %>
  </ul>
  <%= slotted :after %>
</aside>

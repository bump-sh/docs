<% if @paginator.total_pages > 1 %>
  <post-pagination>
    <%= link_or_disabled("Previous", @paginator.previous_page_path, "previous") %>
    <span class="page-count">Page <%= @paginator.page %> of <%= @paginator.total_pages %></span>
    <%= link_or_disabled("Next", @paginator.next_page_path, "next") %>
  </post-pagination>
<% end %>

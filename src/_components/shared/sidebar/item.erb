<li>
  <div class="sidebar-row">
    <%= svg "/docs/images/icons/#{@icon}.svg" if @icon.present? %>
    <% if @resource.present? %>
      <a class="sidebar-link" href="<%= @resource.relative_url %>"<% if current? %> aria-current="page"<% end %>>
        <%= @label %>
      </a>
      <% if @items.present? %>
        <button type="button" class="sidebar-caret" aria-controls="<%= category_id %>" aria-expanded="<%= expanded? %>" aria-label="Toggle <%= @label %> pages" data-action="sidebar#toggle">
          <%= svg "/docs/images/icons/caret-right.svg" %>
        </button>
      <% end %>
    <% else %>
      <button type="button" class="sidebar-link" aria-controls="<%= category_id %>" aria-expanded="<%= expanded? %>" data-action="sidebar#toggle">
        <%= @label %>
        <span class="sidebar-caret"><%= svg "/docs/images/icons/caret-right.svg" %></span>
      </button>
    <% end %>
  </div>
  <% if @items.present? %>
    <ul class="sidebar-sublist" id="<%= category_id %>"<% unless expanded? %> hidden<% end %>>
      <% @items.each do |item| %>
        <%= render Shared::Sidebar::Item.new(page: item, current: @current, parent_id: category_id) %>
      <% end %>
    </ul>
  <% end %>
</li>

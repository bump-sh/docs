<guide-list>
  <% @resources.each do |resource| %>
    <a class="card guide-card" href="<%= resource.relative_url %>">
      <h3><%= resource.data.title %></h3>
      <p><%= resource.data.excerpt %></p>
      <div class="guide-card-meta">
        <%= render Shared::Taglist.new(tags: resource.data.tags) %>
        <%= time_tag resource.data.date %>
      </div>
    </a>
  <% end %>
</guide-list>

---
layout: application
---

<% @entries = site.data.sidebar_entries[resource.data.sidebar_name] %>

<div class="doc-layout" data-controller="toggle" data-action="keydown.esc@window->toggle#close">
  <%= render Shared::Sidebar.new(data: @entries, current: resource) do |sidebar| %>
    <% if resource.data.sidebar_title.present? %>
      <% sidebar.slot :before do %>
        <div class="sidebar-title">
          <%= resource.data.sidebar_title %>
          <% if resource.data.sidebar_versions&.any? %>
            <%= render Guides::VersionSelector.new(
              entries: site.data.sidebar_entries,
              current_url: resource.relative_url,
              current_version: resource.data.sidebar_version,
              available_versions: resource.data.sidebar_versions) %>
          <% end %>
        </div>
      <% end %>
    <% end %>
    <% if resource.data.display_cta.present? %>
      <% sidebar.slot :after do %>
        <%= render Shared::BumpCta.new(slug: resource.data.slug) %>
      <% end %>
    <% end %>
  <% end %>

  <main class="doc-main">
    <div class="doc-mobile-bar">
      <button type="button" class="button" data-button-style="secondary" data-button-size="small" data-toggle-target="button" data-action="toggle#click" aria-expanded="false">
        <%= svg "/docs/images/icons/caret-right.svg" %>
        Menu
      </button>
    </div>

    <article class="doc-article prose">
      <h1><%= data.title %></h1>
      <%= render Guides::InDepth::PostInfo.new(authors: data.authors, last_update: data.date) if resource.data.display_authors %>
      <%= yield %>
      <%= render Shared::PageNavigation.new(entries: @entries, current: resource) if resource.data.display_pagination %>
      <%= render Shared::EditOnGithub.new(relative_path: resource.relative_path) %>
    </article>
  </main>
</div>

---
layout: default
---

<main class="wrapper">
  <article class="update">
    <timeline-element>
      <div class="timeline-side">
        <%= time_tag data.date %>
      </div>
      <div class="timeline-content prose">
        <h2><%= data.title %></h2>
        <div class="tag-list">
          <% data.tags.each do |tag| %>
            <span class="label" data-label-status="inverted"><%= tag %></span>
          <% end %>
        </div>
        <%= yield %>
      </div>
    </timeline-element>
  </article>
</main>
